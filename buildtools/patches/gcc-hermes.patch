diff --color -ruN a/gcc/config/hermes.h b/gcc/config/hermes.h
--- a/gcc/config/hermes.h	1970-01-01 01:00:00.000000000 +0100
+++ b/gcc/config/hermes.h	2026-10-28 21:56:04.376988743 +0100
@@ -0,0 +1,35 @@
+/* Target definitions for HermesOS (mlibc-based userspace).  */
+
+#undef TARGET_HERMES
+#define TARGET_HERMES 1
+
+#undef LIB_SPEC
+#define LIB_SPEC "-lc"
+
+/* mlibc's hermes sysdeps provide crt1.o; x86_64 uses .init_array, so no crti/crtn.
+   Executables start at 1GB: the kernel identity-maps the first gigabyte.  */
+#undef STARTFILE_SPEC
+#define STARTFILE_SPEC "%{!shared:crt1.o%s} %{shared|pie:crtbeginS.o%s;:crtbegin.o%s}"
+
+#undef ENDFILE_SPEC
+#define ENDFILE_SPEC "%{shared|pie:crtendS.o%s;:crtend.o%s}"
+
+#undef LINK_SPEC
+#define LINK_SPEC "%{shared:-shared} %{static:-static} %{!shared:%{!static:%{rdynamic:-export-dynamic} -dynamic-linker /usr/lib/ld.so}} %{!shared:%{!pie:-Ttext-segment=0x40000000}} -z max-page-size=0x1000"
+
+#if defined(HAVE_LD_AS_NEEDED)
+#define USE_LD_AS_NEEDED 1
+#endif
+
+#undef LINK_EH_SPEC
+#define LINK_EH_SPEC "--eh-frame-hdr "
+
+#undef TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()          \
+  do {                                    \
+    builtin_define ("__hermes__");        \
+    builtin_define ("__unix__");          \
+    builtin_assert ("system=hermes");     \
+    builtin_assert ("system=unix");       \
+    builtin_assert ("system=posix");      \
+  } while (0)
